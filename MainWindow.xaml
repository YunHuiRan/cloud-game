<Window x:Class="Ludens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Ludens.Views"
        Title="Cloud Game" Width="1360" Height="860" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True"
        Background="{DynamicResource Bg0}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource Bg0}" ClipToBounds="True">
        <Grid x:Name="BackdropLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Image x:Name="AppBackdrop" Stretch="UniformToFill" Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="BackdropWash" Background="{DynamicResource Bg0}" Opacity="0"/>
            <Border x:Name="BackdropScrim" Background="#000000" Opacity="0"/>
            <Ellipse x:Name="AccentGlow" Width="780" Height="780" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,-430,-220,0" Opacity="0.85"/>
        </Grid>

        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Width="30" Height="30" Source="Assets/brand-64.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Cloud Game" FontFamily="{DynamicResource DisplayFont}" FontSize="17.5"
                               FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="11,0,0,1"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{DynamicResource WindowButton}" Command="{Binding MinimizeCommand}"
                            ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{DynamicResource WindowButton}" Command="{Binding ToggleMaximizeCommand}"
                            ToolTip="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{DynamicResource WindowCloseButton}" Command="{Binding CloseCommand}"
                            ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="14,6,16,14" CornerRadius="20"
                        Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" Padding="16,26,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="浏览" Style="{DynamicResource Eyebrow}" Margin="10,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Border x:Name="NavPill" Height="48" VerticalAlignment="Top" CornerRadius="12"
                                    Background="{DynamicResource AccentSoft}" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="NavPillTransform"/>
                                </Border.RenderTransform>
                                <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource Accent}"/>
                            </Border>
                            <StackPanel x:Name="NavStack">
                                <RadioButton x:Name="NavLibrary" GroupName="Nav" Style="{DynamicResource NavItem}"
                                             Tag="&#xE7FC;" Content="游戏库" IsChecked="True" Checked="Nav_Checked"
                                             Margin="0,0,0,6"/>
                                <RadioButton x:Name="NavStats" GroupName="Nav" Style="{DynamicResource NavItem}"
                                             Tag="&#xE9D2;" Content="统计" Checked="Nav_Checked" Margin="0,0,0,6"/>
                                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{DynamicResource NavItem}"
                                             Tag="&#xE713;" Content="设置" Checked="Nav_Checked"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Border x:Name="NowPlayingPanel" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
                                    BorderBrush="{DynamicResource AccentGlow}" BorderThickness="1" CornerRadius="14"
                                    Padding="13,11,11,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" VerticalAlignment="Center"
                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="正在游玩" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NowPlayingTime" Grid.Column="1" FontSize="10.5"
                                               FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="NowPlayingTitle" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Margin="0,5,0,0" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource Bg3}" CornerRadius="14" Padding="14,12,14,13">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="本周游玩" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock x:Name="SidebarWeekText" Grid.Row="1" Margin="0,3,0,0"
                                               FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="SidebarGamesText" Grid.Column="1" Grid.RowSpan="2"
                                               VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10.5"
                                               Foreground="{DynamicResource TextMuted}" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Button x:Name="QuickThemeButton" Style="{DynamicResource IconButton}" Width="34" Height="34"
                                    HorizontalAlignment="Left" Click="QuickTheme_Click" ToolTip="切换明暗模式">
                                <TextBlock x:Name="QuickThemeGlyph" Text="&#xE706;" FontFamily="{DynamicResource IconFont}"
                                           FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                            <TextBlock Text="v2.0.0" FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">
                    <views:LibraryView x:Name="LibraryPage" Panel.ZIndex="1"/>
                    <views:StatsView x:Name="StatsPage" Panel.ZIndex="2" Visibility="Hidden"/>
                    <views:SettingsView x:Name="SettingsPage" Panel.ZIndex="3" Visibility="Hidden"/>

                    <Grid x:Name="DetailOverlay" Panel.ZIndex="10" Visibility="Collapsed"
                          Background="Transparent" ClipToBounds="True">
                        <views:DetailView x:Name="DetailPage"/>
                    </Grid>

                    <Canvas x:Name="GhostLayer" Panel.ZIndex="11" IsHitTestVisible="False" ClipToBounds="True"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="ModalHost" Panel.ZIndex="30">
            <views:GameEditorView x:Name="EditorPage" Visibility="Collapsed"/>
            <views:ConfirmDialog x:Name="ConfirmPage" Visibility="Collapsed"/>
        </Grid>

        <Grid x:Name="DropHintLayer" Panel.ZIndex="45" Visibility="Collapsed" Opacity="0"
              Background="#B807080B" IsHitTestVisible="False">
            <Border Width="440" Height="216" CornerRadius="24" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Background="{DynamicResource Glass}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DropHintScale" ScaleX="0.96" ScaleY="0.96"/>
                </Border.RenderTransform>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource AccentSoft}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="松开以添加游戏" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"
                               Margin="0,17,0,7"/>
                    <TextBlock Text="支持 .exe / .bat / .cmd 文件" FontSize="12.5"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ToastHost" Panel.ZIndex="50" VerticalAlignment="Bottom" HorizontalAlignment="Center"
              Margin="0,0,0,28" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="ToastBorder" Background="{DynamicResource Elevated}" BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1" CornerRadius="13" Padding="14,11,20,11" MaxWidth="580" Opacity="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.35"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ToastAccentLine" Width="3" CornerRadius="2" Margin="0,1,11,1"
                            Background="{DynamicResource Success}"/>
                    <TextBlock x:Name="ToastGlyph" FontFamily="{DynamicResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
