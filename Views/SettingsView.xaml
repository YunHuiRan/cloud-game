<UserControl x:Class="Ludens.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludens"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{DynamicResource UiFont}"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Padding" Value="28,24,28,26"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="SettingsDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  FocusVisualStyle="{x:Null}">
        <Grid Margin="40,8,40,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,8,0,26">
                <TextBlock Text="设置" Style="{DynamicResource PageTitle}"/>
            </StackPanel>

            <!-- Appearance -->
            <Border Grid.Row="1" Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="主题、强调色与启动器背景。" Style="{StaticResource SettingsDesc}"/>
                    </StackPanel>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="主题模式" Style="{StaticResource RowLabel}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DarkCard" Grid.Column="0" Height="96" CornerRadius="14" Background="#17191F"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="DarkCard_Click" Tag="dark">
                                    <Grid>
                                        <Border Width="49" Height="31" CornerRadius="7" Background="#22252E"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
                                            <Border Width="29" Height="4" CornerRadius="2" Background="{DynamicResource Accent}"
                                                    HorizontalAlignment="Left" Margin="7,0,0,0"/>
                                        </Border>
                                        <Border Width="49" Height="31" CornerRadius="7" Background="#2B2F39"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"/>
                                        <TextBlock Text="暗色" FontSize="12" Foreground="#E8E6E1" HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom" Margin="14,0,0,10"/>
                                        <Border x:Name="DarkCheck" Width="19" Height="19" CornerRadius="9.5" Background="{DynamicResource Accent}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Collapsed">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="LightCard" Grid.Column="2" Height="96" CornerRadius="14" Background="#F1EEE8"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="LightCard_Click" Tag="light">
                                    <Grid>
                                        <Border Width="49" Height="31" CornerRadius="7" Background="#E5E0D8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
                                            <Border Width="29" Height="4" CornerRadius="2" Background="{DynamicResource Accent}"
                                                    HorizontalAlignment="Left" Margin="7,0,0,0"/>
                                        </Border>
                                        <Border Width="49" Height="31" CornerRadius="7" Background="#FAF7F1"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"/>
                                        <TextBlock Text="亮色" FontSize="12" Foreground="#33302B" HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom" Margin="14,0,0,10"/>
                                        <Border x:Name="LightCheck" Width="19" Height="19" CornerRadius="9.5" Background="{DynamicResource Accent}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Visibility="Collapsed">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="强调色" Style="{StaticResource RowLabel}"/>
                            <WrapPanel x:Name="AccentPanel" Margin="0,12,0,0">
                                <Border x:Name="Accent0" Tag="#FF5B3A" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#FF5B3A" CornerRadius="17" Margin="3"/>
                                </Border>
                                <Border x:Name="Accent1" Tag="#5B9DFF" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#5B9DFF" CornerRadius="17" Margin="3"/>
                                </Border>
                                <Border x:Name="Accent2" Tag="#35D6A4" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#35D6A4" CornerRadius="17" Margin="3"/>
                                </Border>
                                <Border x:Name="Accent3" Tag="#FFC24B" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#FFC24B" CornerRadius="17" Margin="3"/>
                                </Border>
                                <Border x:Name="Accent4" Tag="#A78BFA" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#A78BFA" CornerRadius="17" Margin="3"/>
                                </Border>
                                <Border x:Name="Accent5" Tag="#FF7FAE" Width="40" Height="40" CornerRadius="20" BorderThickness="2"
                                        BorderBrush="Transparent" Cursor="Hand" MouseLeftButtonUp="Accent_Click">
                                    <Border Background="#FF7FAE" CornerRadius="17" Margin="3"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,24,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="280" Height="158" CornerRadius="14" Background="{DynamicResource Bg3}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="BgPreviewImage" Stretch="UniformToFill"/>
                                <Border Background="{DynamicResource Scrim}" Opacity="0.35"/>
                                <StackPanel x:Name="BgEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE91B;" Style="{DynamicResource Glyph}" FontSize="24" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="暂无自定义背景" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                        Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="9" Padding="9,4">
                                    <TextBlock x:Name="BgStatusText" Text="默认背景" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="启动器背景" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="支持 JPG / PNG / WebP，导入后会压缩并保存在本地数据目录。" Style="{StaticResource RowHint}" MaxWidth="560"/>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Content="选择图片" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0"
                                        Click="ChooseBackground_Click"/>
                                <Button Content="清除背景" Style="{StaticResource GhostButton}" Height="40" Padding="16,0"
                                        Margin="9,0,0,0" Click="ClearBackground_Click"/>
                            </StackPanel>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DimLabel" Grid.Column="0" Text="背景暗度" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <Slider x:Name="DimSlider" Grid.Column="1" Margin="16,0" Minimum="0" Maximum="0.9" SmallChange="0.01"
                                        ValueChanged="DimSlider_ValueChanged"/>
                                <TextBlock x:Name="DimValueText" Grid.Column="2" Text="48%" Style="{DynamicResource MonoText}"
                                           FontSize="11" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <Border Grid.Row="2" Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="行为" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="启动器如何响应关闭窗口。" Style="{StaticResource SettingsDesc}"/>
                    </StackPanel>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="游戏仍在运行时，关闭窗口只会隐藏到系统托盘，游戏结束后再退出。" Style="{StaticResource RowHint}" MaxWidth="680"/>
                        </StackPanel>
                        <CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Grid.Row="3" Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="数据与备份" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="游玩记录、封面和背景都保存在本机。导出的 JSON 可随时迁移到另一台电脑。" Style="{StaticResource SettingsDesc}"/>
                    </StackPanel>

                    <Border Background="{DynamicResource Bg3}" CornerRadius="14" Padding="18,15" Margin="0,20,0,18">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="DataSummaryText" Text="0 款游戏 · 0 次游玩" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DataPathText" Text="" Style="{DynamicResource Caption}" FontSize="11"
                                           Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Height="36" Padding="14,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenDataFolder_Click"/>
                        </Grid>
                    </Border>

                    <WrapPanel>
                        <Button Style="{StaticResource SecondaryButton}" Height="42" Padding="18,0" Click="ExportPlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{DynamicResource Glyph}" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="导出游玩数据" FontSize="13.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="42" Padding="18,0" Margin="10,0,0,0" Click="ExportFull_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{DynamicResource Glyph}" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="导出完整备份" FontSize="13.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Height="42" Padding="18,0" Margin="10,0,0,0" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" Style="{DynamicResource Glyph}" FontSize="14" Margin="0,0,9,0"/>
                                <TextBlock Text="导入数据" FontSize="13.5"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Grid.Row="4" Style="{StaticResource SettingsCard}" Padding="24,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="Assets/brand-64.png" Width="34" Height="34" VerticalAlignment="Center"/>
                    <TextBlock Text="Cloud Game" FontFamily="{DynamicResource DisplayFont}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="2.0.0" FontSize="10" Foreground="{DynamicResource Accent}"
                                   FontFamily="{DynamicResource MonoFont}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
