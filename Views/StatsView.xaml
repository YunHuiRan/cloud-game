<UserControl x:Class="Ludens.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludens"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{DynamicResource UiFont}"
             FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Padding" Value="20,17,18,16"/>
            <Setter Property="MinHeight" Value="112"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"
                  FocusVisualStyle="{x:Null}">
        <Grid Margin="40,8,40,48" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,8,0,26">
                <StackPanel>
                    <TextBlock Text="统计数据" Style="{DynamicResource PageTitle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource AccentSoft}"
                        CornerRadius="20" Padding="13,6" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="LiveStatusText" Text="本地数据" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="总游玩时长" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TotalTimeText" Text="0 分钟" Style="{StaticResource MetricValue}" Margin="0,9,0,0" FontSize="24"/>
                            <TextBlock x:Name="TotalTimeHint" Text="全部游戏累计" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Text="&#xE823;" Style="{DynamicResource Glyph}" FontSize="17" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="{DynamicResource Accent}" Opacity="0.55"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="最近 7 天" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="WeekTimeText" Text="0 分钟" Style="{StaticResource MetricValue}" Margin="0,9,0,0" FontSize="24"/>
                            <TextBlock x:Name="WeekTimeHint" Text="较上周" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Text="&#xE787;" Style="{DynamicResource Glyph}" FontSize="17" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="{DynamicResource Accent}" Opacity="0.55"/>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="游戏库" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="GameCountText" Text="0 款" Style="{StaticResource MetricValue}" Margin="0,9,0,0"/>
                            <TextBlock x:Name="GameCountHint" Text="已收录游戏" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock Text="&#xE8F1;" Style="{DynamicResource Glyph}" FontSize="17" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="{DynamicResource Accent}" Opacity="0.55"/>
                    </Grid>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="最常玩" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TopGameText" Text="—" Style="{StaticResource MetricValue}" FontSize="20"
                                       TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
                            <TextBlock x:Name="TopGameHint" Text="还没有记录" Style="{StaticResource MetricLabel}" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="&#xE735;" Style="{DynamicResource Glyph}" FontSize="16" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Foreground="{DynamicResource Accent}" Opacity="0.55"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{DynamicResource PanelCard}" Padding="24,21,24,20" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="游玩节奏" Style="{DynamicResource SectionTitle}" FontSize="17"/>
                            <TextBlock Text="最近 7 天的游戏时间分布" Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="WeekSummaryText" Text="共 0 分钟" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{DynamicResource MonoText}" FontSize="11"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Top"/>
                            <Border Grid.Row="1" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Top" Opacity="0.6"/>
                            <Border Grid.Row="2" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Top" Opacity="0.35"/>
                            <Border Grid.Row="3" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Top" Opacity="0.2"/>
                        </Grid>
                        <ItemsControl x:Name="DaysList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="26"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ValueText}" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <Border x:Name="Bar" Width="34" Height="{Binding BarHeight}" CornerRadius="5,5,2,2"
                                                    Background="{DynamicResource Accent}" RenderTransformOrigin="0.5,1" ToolTip="{Binding Tooltip}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                                                      Color="#000000" Opacity="0.18"/>
                                                </Border.Effect>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{Binding LabelBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="柱形按每日游玩时长等比缩放" Style="{DynamicResource Caption}" FontSize="10.5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="本次统计包含正在运行的游戏" Style="{DynamicResource Caption}" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{DynamicResource PanelCard}" Padding="26,22,26,20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="最近游玩" Style="{DynamicResource SectionTitle}" FontSize="18"/>
                        <TextBlock Text="全部游戏" Style="{DynamicResource Caption}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="RecentList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DateText}" Style="{DynamicResource Caption}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{DynamicResource MonoText}"
                                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyRecent" Margin="0,18,0,4" Visibility="Collapsed">
                        <TextBlock Text="启动游戏后，这里会留下时间线。" Style="{DynamicResource BodyMuted}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
