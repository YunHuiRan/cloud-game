<UserControl x:Class="Ludens.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{DynamicResource UiFont}"
             Visibility="Collapsed">
    <Grid x:Name="Root">
        <Border x:Name="Scrim" Background="#A6000000" MouseDown="Scrim_MouseDown"/>
        <Border x:Name="DialogPanel" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Elevated}" CornerRadius="16" BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1" Padding="26,24,26,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="16" Direction="270" Color="#000000" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="12" Background="#1FFF6577"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="IconGlyph" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="DialogTitle" Text="移除游戏" Style="{DynamicResource PageTitle}" FontSize="23" Margin="0,17,0,0"/>
                <TextBlock x:Name="DialogMessage" Text="" Style="{DynamicResource BodyMuted}" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
                <Border Background="{DynamicResource Bg3}" CornerRadius="9" Padding="12,9" Margin="0,16,0,0">
                    <TextBlock x:Name="DialogHint" Text="这个操作无法撤销。" FontSize="10.5"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Height="36" Padding="17,0" Content="取消" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Height="36" Padding="17,0"
                            Margin="8,0,0,0" Content="确认移除" Click="Confirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
