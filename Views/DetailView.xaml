<UserControl x:Class="Ludens.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludens"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="DetailStatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style x:Key="DetailInfoKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DetailInfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SessionDuration" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="38,0,30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource GhostButton}" Height="34" Padding="10,0"
                            Click="Back_Click" ToolTip="返回游戏库">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" Style="{DynamicResource Glyph}" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="返回游戏库" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" FocusVisualStyle="{x:Null}">
                <Grid MaxWidth="1160" Margin="38,14,38,52" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Top">
                            <Border x:Name="CoverElement" Width="286" Height="382" CornerRadius="17"
                                    Background="Transparent" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    BorderThickness="0">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,286,382" RadiusX="17" RadiusY="17"/>
                                </Border.Clip>
                                <Grid>
                                    <TextBlock x:Name="CoverInitial" Text="{Binding Initial}" FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="132" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"/>
                                    <Image x:Name="CoverImage" Stretch="UniformToFill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="38,8,0,0">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{Binding ExeFileName}" Style="{DynamicResource Eyebrow}"
                                           FontSize="10.5" VerticalAlignment="Center"/>
                                <Border x:Name="RunningChip" Background="{DynamicResource AccentSoft}" CornerRadius="20"
                                        Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="运行中" FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Image x:Name="LogoImage" Height="58" MaxWidth="330" HorizontalAlignment="Left"
                                   Stretch="Uniform" Margin="0,0,0,8" Visibility="Collapsed"/>

                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap"
                                       FontFamily="{DynamicResource DisplayFont}" FontSize="48" FontWeight="Bold"
                                       LineHeight="54" TextTrimming="CharacterEllipsis" MaxHeight="112"/>

                            <TextBlock Text="{Binding MetaLine}" Style="{DynamicResource BodyMuted}" Margin="0,13,0,0"
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}"/>

                            <TextBlock x:Name="DescriptionText" Text="{Binding Description}" TextWrapping="Wrap"
                                       FontSize="13.5" LineHeight="23" Foreground="{DynamicResource TextSecondary}"
                                       MaxWidth="640" Margin="0,14,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button x:Name="PlayButton" Style="{DynamicResource PrimaryButton}" Height="50" Padding="26,0"
                                        Click="Play_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="14" Foreground="{DynamicResource AccentForeground}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="PlayLabel" Text="开始游戏" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentForeground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FavoriteButton" Style="{DynamicResource IconButton}" Width="40" Height="40"
                                        Margin="12,0,0,0" Click="Favorite_Click" ToolTip="收藏 / 取消收藏">
                                    <TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" Style="{DynamicResource Glyph}" FontSize="16"/>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" Width="40" Height="40" Margin="6,0,0,0"
                                        Click="Edit_Click" ToolTip="编辑游戏">
                                    <TextBlock Text="&#xE70F;" Style="{DynamicResource Glyph}" FontSize="15"/>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" Width="40" Height="40" Margin="6,0,0,0"
                                        Click="Reveal_Click" ToolTip="在资源管理器中显示">
                                    <TextBlock Text="&#xE838;" Style="{DynamicResource Glyph}" FontSize="15"/>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" Width="40" Height="40" Margin="6,0,0,0"
                                        Click="Delete_Click" ToolTip="从游戏库移除">
                                    <TextBlock Text="&#xE74D;" Style="{DynamicResource Glyph}" FontSize="15"
                                               Foreground="{DynamicResource Danger}"/>
                                </Button>
                            </StackPanel>

                            <Border Margin="0,18,0,0" Padding="18,14"
                                    Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TotalPlaytimeText" Text="{Binding PlaytimeLongDisplay}"
                                                   Style="{DynamicResource StatNumber}" FontSize="23"/>
                                        <TextBlock Text="累计游玩" Style="{StaticResource DetailStatLabel}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Border}" Margin="16,2,16,2"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="LastPlayedText" Text="{Binding LastPlayedDisplay}"
                                                   Style="{DynamicResource StatNumber}" FontSize="23"/>
                                        <TextBlock Text="最近游玩" Style="{StaticResource DetailStatLabel}"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Background="{DynamicResource Border}" Margin="16,2,16,2"/>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{Binding LaunchCount}" Style="{DynamicResource StatNumber}" FontSize="23"/>
                                        <TextBlock Text="启动次数" Style="{StaticResource DetailStatLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,46,0,0">
                        <Border Style="{DynamicResource PanelCard}" Padding="24,21,24,22" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="游玩日历" Style="{DynamicResource SectionTitle}" FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button x:Name="PrevMonthButton" Style="{DynamicResource IconButton}"
                                                    Width="28" Height="28" Click="PrevMonth_Click" ToolTip="上个月">
                                                <TextBlock Text="&#xE76B;" Style="{DynamicResource Glyph}" FontSize="11"/>
                                            </Button>
                                            <Button x:Name="NextMonthButton" Style="{DynamicResource IconButton}"
                                                    Width="28" Height="28" Margin="3,0,0,0" Click="NextMonth_Click" ToolTip="下个月">
                                                <TextBlock Text="&#xE76C;" Style="{DynamicResource Glyph}" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="CalendarRangeText" Style="{DynamicResource Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CalendarSummaryText" Style="{DynamicResource Caption}" Margin="0,5,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="520"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <UniformGrid Columns="7" Width="520">
                                            <TextBlock Text="一" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="二" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="三" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="四" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="五" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="六" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                            <TextBlock Text="日" Style="{DynamicResource Caption}" FontSize="10" TextAlignment="Center"/>
                                        </UniformGrid>
                                        <ItemsControl x:Name="CalendarDays" Width="520" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="34" Margin="3" CornerRadius="5"
                                                            Background="{DynamicResource Bg3}"
                                                            BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                                            Opacity="{Binding CellOpacity}"
                                                            ToolTip="{Binding Tooltip}"
                                                            ToolTipService.ShowDuration="30000">
                                                        <Grid>
                                                            <Border Background="{Binding Fill}" CornerRadius="4"/>
                                                            <TextBlock Text="{Binding DayNumber}"
                                                                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                                       Foreground="{Binding TextBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="28,2,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="单日游玩时长" Style="{DynamicResource Caption}" Margin="0,0,0,9"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="少" Style="{DynamicResource Caption}" FontSize="9.5" Margin="0,0,7,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Accent}" Opacity="0.18" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Accent}" Opacity="0.34" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Accent}" Opacity="0.52" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Accent}" Opacity="0.74" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Accent}" Opacity="1" Margin="0,0,7,0"/>
                                            <TextBlock Text="多" Style="{DynamicResource Caption}" FontSize="9.5"/>
                                        </StackPanel>
                                        <TextBlock Text="每格代表一天，颜色越深表示游玩时间越长。"
                                                   Style="{DynamicResource Caption}" FontSize="10.5" TextWrapping="Wrap"
                                                   MaxWidth="260" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource PanelCard}" Padding="24,21,24,18" Margin="0,18,0,0">
                                <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="游玩记录" Style="{DynamicResource SectionTitle}" FontSize="16"/>
                                        <Border Background="{DynamicResource Bg3}" CornerRadius="10" Padding="8,2" Margin="10,1,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="SessionCountText" Text="0" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="最近 8 次" Style="{DynamicResource Caption}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="SessionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding TimeDisplay}" Style="{DynamicResource MonoText}"
                                                               FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Grid Grid.Column="1" Margin="8,0,16,0">
                                                    <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center"/>
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" HorizontalAlignment="Left"
                                                             VerticalAlignment="Center" Opacity="0.8"/>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" Style="{StaticResource SessionDuration}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel x:Name="EmptySessions" VerticalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed">
                                    <TextBlock Text="&#xE823;" Style="{DynamicResource Glyph}" FontSize="22" Opacity="0.4"/>
                                    <TextBlock Text="还没有游玩记录" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource PanelCard}" Padding="24,21,24,22" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="游戏信息" Style="{DynamicResource SectionTitle}" FontSize="16" Margin="0,0,0,18"/>
                                <TextBlock Text="可执行文件" Style="{StaticResource DetailInfoKey}"/>
                                <TextBlock x:Name="ExeText" Style="{StaticResource DetailInfoValue}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="11" Margin="0,0,0,15" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="工作目录" Style="{StaticResource DetailInfoKey}"/>
                                <TextBlock x:Name="WorkDirText" Style="{StaticResource DetailInfoValue}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="11" Margin="0,0,0,15" TextTrimming="CharacterEllipsis"/>
                                <StackPanel>
                                    <TextBlock Text="添加日期" Style="{StaticResource DetailInfoKey}"/>
                                    <TextBlock x:Name="AddedText" Style="{StaticResource DetailInfoValue}" Margin="0,0,0,14"/>
                                </StackPanel>
                                <TextBlock Text="游戏编号" Style="{StaticResource DetailInfoKey}"/>
                                <TextBlock x:Name="IdText" Style="{StaticResource MonoText}" FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

