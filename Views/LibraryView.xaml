<UserControl x:Class="Ludens.Views.LibraryView"
             PreviewMouseDown="Root_PreviewMouseDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludens"
             x:Name="View">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="CoverShade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.30"/>
            <GradientStop Color="#16000000" Offset="0.58"/>
            <GradientStop Color="#E0000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GameCardButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="198"/>
            <Setter Property="Margin" Value="0,0,18,26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.022" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.022" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.985" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.985" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameRowButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="RowHover" Background="{DynamicResource Hover}" CornerRadius="16"
                                        Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.014" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.014" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowHover" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewToggleButton" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchIconButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="FlipRoot" Margin="40,0,40,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Text="游戏库"/>
                    <Border x:Name="RunningBadge" Background="{DynamicResource AccentSoft}" CornerRadius="11"
                            Padding="10,4" Margin="15,8,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RunningBadgeText" Text="1 个游戏运行中" FontSize="12"
                                       Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" Text="" Margin="2,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border x:Name="SearchShell" Width="44" Height="44" CornerRadius="12" Margin="0,0,10,0"
                        Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        LostKeyboardFocus="SearchShell_LostKeyboardFocus">
                    <Grid ClipToBounds="True">
                        <TextBox x:Name="SearchBox" Width="0" Opacity="0" Height="42" Margin="38,0,28,0"
                                 VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"
                                 FontSize="14" Padding="4,0,0,0" TextChanged="SearchBox_TextChanged"/>
                        <Button x:Name="SearchToggleButton" Style="{StaticResource SearchIconButton}" Width="43" Height="42"
                                HorizontalAlignment="Left" Click="SearchToggle_Click" ToolTip="搜索">
                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                        <Button x:Name="ClearSearchButton" Style="{StaticResource SearchIconButton}" Width="26" Height="26"
                                HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed"
                                Click="ClearSearch_Click" ToolTip="清除">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="SortButton" Style="{StaticResource SecondaryButton}" Width="148" Height="44"
                        Margin="0,0,10,0" Padding="14,0" HorizontalContentAlignment="Center"
                        Click="SortButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Width="226" Placement="Bottom" Opened="SortMenu_Opened" Closed="SortMenu_Closed">
                            <MenuItem Header="最近游玩" Tag="&#xE823;" CommandParameter="recent" Click="SortMenu_Click"
                                      InputGestureText="默认"/>
                            <MenuItem Header="游戏名称" Tag="&#xE8D2;" CommandParameter="title" Click="SortMenu_Click"/>
                            <MenuItem Header="游玩时长" Tag="&#xE916;" CommandParameter="playtime" Click="SortMenu_Click"/>
                            <MenuItem Header="添加时间" Tag="&#xE8B7;" CommandParameter="added" Click="SortMenu_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8CB;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SortLabel" Text="最近游玩" FontSize="13.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SortChevron" Text="&#xE70D;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}" Margin="8,1,0,0" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SortChevronRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="22" Padding="3" Margin="0,0,10,0" Height="44" VerticalAlignment="Center">
                    <Grid Width="76" Height="38">
                        <Border x:Name="ViewModeThumb" Width="36" Height="36" Margin="1" CornerRadius="18"
                                Background="{DynamicResource AccentSoft}"
                                BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ViewThumbShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GridViewButton" Style="{StaticResource ViewToggleButton}"
                                     Checked="ViewMode_Checked" GroupName="ViewMode" ToolTip="网格视图">
                            <Grid Width="15" Height="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6.5"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="6.5"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="6.5"/>
                                    <RowDefinition Height="2"/>
                                    <RowDefinition Height="6.5"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.Column="0" RadiusX="1.6" RadiusY="1.6"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Grid.Row="0" Grid.Column="2" RadiusX="1.6" RadiusY="1.6"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Grid.Row="2" Grid.Column="0" RadiusX="1.6" RadiusY="1.6"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Rectangle Grid.Row="2" Grid.Column="2" RadiusX="1.6" RadiusY="1.6"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="ListViewButton" Style="{StaticResource ViewToggleButton}"
                                     Checked="ViewMode_Checked" GroupName="ViewMode" ToolTip="列表视图">
                            <StackPanel Width="15" Height="15" VerticalAlignment="Center">
                                <Grid Height="3" Margin="0,0,0,2.5">
                                    <Rectangle Width="3" Height="3" RadiusX="1" HorizontalAlignment="Left"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Height="3" Width="10" RadiusX="1.2" HorizontalAlignment="Right"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                                <Grid Height="3" Margin="0,0,0,2.5">
                                    <Rectangle Width="3" Height="3" RadiusX="1" HorizontalAlignment="Left"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Height="3" Width="10" RadiusX="1.2" HorizontalAlignment="Right"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                                <Grid Height="3">
                                    <Rectangle Width="3" Height="3" RadiusX="1" HorizontalAlignment="Left"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <Rectangle Height="3" Width="10" RadiusX="1.2" HorizontalAlignment="Right"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </Grid>
                            </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Height="44" Padding="19,0" Click="AddGame_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="添加游戏" FontSize="13.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,24,0,16" x:Name="FilterRow">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" Style="{StaticResource ChipButton}" Content="全部" Tag="0"
                             IsChecked="True" Checked="Filter_Checked" Margin="0,0,8,0"/>
                <RadioButton x:Name="FilterRecent" Style="{StaticResource ChipButton}" Content="最近 30 天" Tag="1"
                             Checked="Filter_Checked" Margin="0,0,8,0"/>
                <RadioButton x:Name="FilterFavorite" Style="{StaticResource ChipButton}" Content="收藏" Tag="2"
                             Checked="Filter_Checked"/>
            </StackPanel>
            <TextBlock x:Name="ResultText" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Text=""/>
        </Grid>

        <!-- Game collection -->
        <Grid Grid.Row="2" x:Name="CollectionHost">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,10,0" PanningMode="VerticalOnly">
                <StackPanel x:Name="CollectionPanel" Margin="0,0,0,30">
                    <ItemsControl x:Name="GameGrid">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="CardButton" Style="{StaticResource GameCardButton}" Click="Card_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="开始游戏" Tag="&#xE768;" Click="PlayMenu_Click"/>
                                            <MenuItem Header="停止游戏" Tag="&#xE71A;" Click="StopMenu_Click"
                                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="查看详情" Tag="&#xE8A7;" Click="DetailMenu_Click"/>
                                            <MenuItem Header="编辑信息" Tag="&#xE70F;" Click="EditMenu_Click"/>
                                            <MenuItem Header="收藏 / 取消收藏" Tag="&#xE734;" Click="FavoriteMenu_Click"/>
                                            <MenuItem Header="在资源管理器中显示" Tag="&#xE838;" Click="RevealMenu_Click"/>
                                            <Separator/>
                                            <MenuItem Header="从游戏库移除" Tag="&#xE74D;" Click="DeleteMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="264"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="CoverFrame" Grid.Row="0" CornerRadius="16" ClipToBounds="True"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Background="{DynamicResource Card}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,198,264" RadiusX="16" RadiusY="16"/>
                                            </Border.Clip>
                                            <Grid>
                                                <Border CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality"
                                                        Background="{Binding CoverAbsolutePath, Converter={StaticResource PathToImageBrush}}"/>
                                                <TextBlock Text="{Binding Initial}" FontFamily="{DynamicResource DisplayFont}"
                                                           FontSize="74" FontWeight="Black" Foreground="#12FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border Background="{StaticResource CoverShade}"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11"
                                                        Background="#B3000000" CornerRadius="9" Padding="9,4"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="运行中" FontSize="11" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="PlayVeil" Background="#3D000000" Opacity="0">
                                                    <Border Width="56" Height="56" CornerRadius="28"
                                                            Background="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock x:Name="PlayVeilGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="19"
                                                                   Foreground="{DynamicResource AccentForeground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    </Border>
                                                </Border>
                                                <Button x:Name="QuickPlayButton" Width="56" Height="56" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" Click="CardPlay_Click" Cursor="Hand"
                                                        FocusVisualStyle="{x:Null}" ToolTip="启动 / 停止"
                                                        IsHitTestVisible="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="11"
                                                        Background="#A6000000" CornerRadius="8" Padding="9,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE823;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                                                   Foreground="#B8FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="11" Foreground="White"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="2,11,2,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="15"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding LastPlayedDisplay}" Style="{StaticResource Caption}" FontSize="12"/>
                                                <TextBlock x:Name="MetaDot" Text="  ·  " Style="{StaticResource Caption}" FontSize="12"
                                                           Visibility="{Binding MetaLine, Converter={StaticResource EmptyToVisible}}"/>
                                                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Caption}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardButton" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PlayVeil" Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PlayVeil" Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="PlayVeilGlyph" Property="Text" Value="&#xE71A;"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="GameList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid PreviewMouseLeftButtonDown="GameRow_PreviewMouseDown">
                                <Button Style="{StaticResource GameRowButton}" Click="Card_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="开始游戏" Tag="&#xE768;" Click="PlayMenu_Click"/>
                                            <MenuItem Header="停止游戏" Tag="&#xE71A;" Click="StopMenu_Click"
                                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="查看详情" Tag="&#xE8A7;" Click="DetailMenu_Click"/>
                                            <MenuItem Header="编辑信息" Tag="&#xE70F;" Click="EditMenu_Click"/>
                                            <MenuItem Header="收藏 / 取消收藏" Tag="&#xE734;" Click="FavoriteMenu_Click"/>
                                            <MenuItem Header="在资源管理器中显示" Tag="&#xE838;" Click="RevealMenu_Click"/>
                                            <Separator/>
                                            <MenuItem Header="从游戏库移除" Tag="&#xE74D;" Click="DeleteMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="RowCover" Width="76" Height="104" CornerRadius="13" ClipToBounds="True"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Background="{Binding CoverAbsolutePath, Converter={StaticResource PathToImageBrush}}">
                                            <Border.Clip>
                                                <RectangleGeometry Rect="0,0,76,104" RadiusX="13" RadiusY="13"/>
                                            </Border.Clip>
                                            <Grid>
                                                <Border Background="{StaticResource CoverShade}"/>
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                                                        Background="#A6000000" CornerRadius="7" Padding="7,3">
                                                    <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="16"/>
                                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="7,3" Margin="10,1,0,0"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="运行中" FontSize="10.5" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Caption}" FontSize="12.5"
                                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                                            <TextBlock Text="{Binding LastPlayedDisplay}" Style="{StaticResource Caption}" FontSize="11.5"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="18,0,10,0">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                                <TextBlock Text="{Binding PlaytimeLongDisplay}" FontSize="14.5" Foreground="{DynamicResource TextPrimary}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="累计游玩" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentSoft}">
                                                <TextBlock x:Name="RowPlayGlyph" Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="1,0,0,0"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="RowPlayGlyph" Property="Text" Value="&#xE71A;"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid x:Name="EmptyState" Visibility="Collapsed" Margin="0,68,0,40">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border Width="96" Height="96" CornerRadius="28" Background="{DynamicResource AccentSoft}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" FontFamily="{DynamicResource IconFont}" FontSize="36"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="游戏库还是空的" FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                            <TextBlock x:Name="EmptyHint" Text="添加一个本地游戏，Cloud Game 会自动记录你的游玩时间。"
                                       Style="{StaticResource BodyMuted}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Width="156" Height="44" Margin="0,24,0,0"
                                    HorizontalAlignment="Center" Click="AddGame_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="添加游戏" FontSize="13.5"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="也可以直接把 .exe 文件拖进窗口" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
