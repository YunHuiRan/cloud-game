<UserControl x:Class="Ludens.Views.GameEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{DynamicResource UiFont}"
             Visibility="Collapsed"
             FocusVisualStyle="{x:Null}">
    <Grid x:Name="Root">
        <Border x:Name="Scrim" Background="#B8000000" MouseDown="Scrim_MouseDown"/>

        <Border x:Name="EditorPanel" Width="864" MaxHeight="752" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Card}" CornerRadius="20" BorderBrush="{DynamicResource BorderStrong}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="20" Direction="270" Color="#000000" Opacity="0.44"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="30,22,20,18">
                    <TextBlock x:Name="EditorTitle" Text="添加游戏" Style="{DynamicResource SectionTitle}" FontSize="24"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource WindowButton}" Width="34" Height="34"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="10"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}">
                    <Grid Margin="30,0,30,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="封面" Style="{DynamicResource Caption}" FontSize="12.5" Margin="1,0,0,9"/>
                            <Border Width="210" Height="280" CornerRadius="16" Background="{DynamicResource Bg3}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="CoverImage" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,210,280" RadiusX="16" RadiusY="16"/>
                                        </Image.Clip>
                                    </Image>
                                    <Grid x:Name="CoverPlaceholder">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF6B4A" Offset="0"/>
                                                <GradientStop Color="#B2311F" Offset="0.55"/>
                                                <GradientStop Color="#2B1712" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <Ellipse Width="200" Height="200" Stroke="#33FFFFFF" StrokeThickness="1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-74,-84,0"/>
                                        <Ellipse Width="124" Height="124" Stroke="#26FFFFFF" StrokeThickness="1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-26,0"/>
                                        <TextBlock x:Name="PreviewInitial" Text="C" FontFamily="{DynamicResource DisplayFont}" FontSize="112"
                                                   FontWeight="Bold" Foreground="#EFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="16,4,0,0"/>
                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                                            <TextBlock x:Name="PreviewTitle" Text="未命名游戏" FontFamily="{DynamicResource DisplayFont}"
                                                       FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxHeight="50"/>
                                            <TextBlock x:Name="PreviewMeta" Text="" FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="8" Foreground="#CCFFFFFF" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="CoverBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                            Background="#A6000000" CornerRadius="7" Padding="7,3" Visibility="Collapsed">
                                        <TextBlock Text="自定义" FontSize="8.5" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Margin="1,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0"
                                        FontSize="11.5" Click="ChooseCover_Click" Content="选择封面"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="34" Padding="10,0"
                                        FontSize="11.5" Margin="7,0,0,0" Click="RegenerateCover_Click" Content="自动"/>
                            </Grid>
                            <TextBlock x:Name="CoverStatusText" Text="将自动生成封面" Style="{DynamicResource Caption}"
                                       FontSize="10" Margin="1,7,0,0" TextTrimming="CharacterEllipsis"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="游戏名称" Style="{DynamicResource Caption}" FontSize="12.5" Margin="1,0,0,8"/>
                            <TextBox x:Name="TitleBox" Style="{DynamicResource TextBoxBase}" Height="46" Text=""
                                     Tag="例如：Hollow Knight" TextChanged="TitleBox_TextChanged"/>

                            <TextBlock Text="可执行文件" Style="{DynamicResource Caption}" FontSize="12.5" Margin="1,22,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExeBox" Grid.Column="0" Style="{DynamicResource TextBoxBase}" Height="46" Text=""
                                         Tag="选择或粘贴游戏路径" TextChanged="ExeBox_TextChanged"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="46" Padding="16,0"
                                        Margin="9,0,0,0" Click="BrowseExe_Click" Content="浏览…"/>
                            </Grid>
                            <TextBlock Text="支持 .exe / .bat / .cmd" Style="{DynamicResource Caption}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="1,7,0,0"/>

                            <Border Background="{DynamicResource Bg3}" CornerRadius="14" Padding="16,13" Margin="0,26,0,0">
                                <TextBlock Text="保存后会生成封面，也可以在游戏库中随时更换。"
                                           Style="{DynamicResource Caption}" FontSize="11.5" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource Danger}" FontSize="12"
                                       Margin="1,16,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Height="42" Padding="20,0" Content="取消"
                                Click="Cancel_Click"/>
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Height="42" Padding="24,0"
                                Margin="10,0,0,0" Click="Save_Click" Content="添加到库"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
